{
  "name": "safex-ai-chrome-extension",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "demo": "node scripts/demo.mjs",
    "format": "prettier --write src scripts tests/*.mjs tests/*.ts ../shared/security-engine/src public/*.html public/*.css manifest.json package.json tsconfig.json demo README.md",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/engine.test.ts tests/privacy.test.ts",
    "test:browser": "node tests/browser.mjs && node tests/browser-protection.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:browser && npm run test:guidance",
    "package": "node scripts/package.mjs",
    "record:validation": "node scripts/record-validation.mjs",
    "test:guidance": "node tests/guidance-browser.mjs"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "punycode": "2.3.1",
    "tesseract.js": "7.0.0",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/chrome": "0.3.4",
    "@types/node": "24.10.1",
    "@types/punycode": "2.1.4",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  }
}
