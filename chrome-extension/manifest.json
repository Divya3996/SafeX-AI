{
  "manifest_version": 3,
  "name": "SafeX AI",
  "description": "__MSG_extensionDescription__",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "default_locale": "en",
  "incognito": "not_allowed",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "sidePanel",
    "alarms",
    "offscreen",
    "declarativeNetRequest"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SafeX AI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "sidepanel.html#settings",
  "commands": {
    "scan-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_scanPage__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self'; worker-src 'self'; frame-src 'none'; base-uri 'none';"
  }
}
